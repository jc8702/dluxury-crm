{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "D'Luxury CRM Design System",
  "version": "3.0.0",
  "description": "Design System D'Luxury — paleta oficial: azul primário, teal secundário, dourado accent, off-white de fundo, branco de superfície, preto de texto e semânticas padronizadas.",
  "color": {
    "primary": {
      "50": "#e6f1fc",
      "100": "#cce3f9",
      "200": "#99c7f3",
      "300": "#66abed",
      "400": "#338fe7",
      "500": "#0D66CC",
      "600": "#0a52a3",
      "700": "#083d7a",
      "800": "#052952",
      "900": "#031429"
    },
    "secondary": {
      "50": "#e0f7f5",
      "100": "#b3ebe5",
      "200": "#80dcd2",
      "300": "#4dcdbe",
      "400": "#1abeab",
      "500": "#00A99D",
      "600": "#008b84",
      "700": "#006b66",
      "800": "#004d47",
      "900": "#002e2b"
    },
    "accent": {
      "50": "#fdf6df",
      "100": "#faebb0",
      "200": "#f5dd80",
      "300": "#f0cf50",
      "400": "#ebc120",
      "500": "#E2AC00",
      "600": "#b38900",
      "700": "#856700",
      "800": "#564400",
      "900": "#2b2200"
    },
    "neutral": {
      "0": "#ffffff",
      "50": "#fafafa",
      "100": "#f4f4f5",
      "200": "#e4e4e7",
      "300": "#d4d4d8",
      "400": "#a1a1aa",
      "500": "#71717a",
      "600": "#52525b",
      "700": "#3f3f46",
      "800": "#27272a",
      "900": "#1a1a1a"
    },
    "semantic": {
      "error": "#DC3545",
      "error-soft": "#fde2e4",
      "success": "#28A745",
      "success-soft": "#d8f0dd",
      "warning": "#FFC107",
      "warning-soft": "#fff4cf",
      "info": "#17A2B8",
      "info-soft": "#d3eef4"
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "scale": "4px-grid"
  },
  "radius": {
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "full": "9999px",
    "components": "8px",
    "containers": "12px"
  },
  "shadow": {
    "depth-1": "0 1px 2px 0 rgb(26 26 26 / 0.04), 0 1px 1px 0 rgb(26 26 26 / 0.03)",
    "depth-2": "0 4px 8px -2px rgb(26 26 26 / 0.06), 0 2px 4px -2px rgb(26 26 26 / 0.04)",
    "depth-3": "0 12px 24px -4px rgb(26 26 26 / 0.10), 0 4px 8px -2px rgb(26 26 26 / 0.06)",
    "focus": "0 0 0 3px rgb(13 102 204 / 0.20)",
    "focus-danger": "0 0 0 3px rgb(220 53 69 / 0.20)"
  },
  "typography": {
    "family": {
      "sans": "Plus Jakarta Sans, system-ui, -apple-system, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, SF Mono, Menlo, monospace"
    },
    "size": {
      "xs": "11px",
      "sm": "13px",
      "base": "14px",
      "md": "15px",
      "lg": "16px",
      "xl": "18px",
      "2xl": "22px",
      "3xl": "28px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.45,
      "relaxed": 1.6
    }
  },
  "z-index": {
    "base": 0,
    "dropdown": 50,
    "sticky": 80,
    "modal-backdrop": 100,
    "modal": 110,
    "toast": 200,
    "tooltip": 300
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "180ms",
      "slow": "260ms"
    },
    "ease": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  }
}
