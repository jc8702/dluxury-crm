# Banco de dados (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Secret (mínimo 32 caracteres)
APP_JWT_SECRET="substitua-por-string-aleatoria-de-32-chars-minimo"

# Admin padrão
ADMIN_DEFAULT_EMAIL="admin@dluxury.com"
ADMIN_DEFAULT_PASSWORD="substitua-antes-de-usar"

# Vercel (preenchido automaticamente pela Vercel)
VERCEL_ENV="production"
VERCEL_URL=""

# Upstash Redis (opcional — para rate limiting distribuído)
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# Sentry (opcional — para monitoramento de erros)
SENTRY_DSN=""

# Google AI (opcional — para features de IA)
GOOGLE_GENERATIVE_AI_API_KEY=""
